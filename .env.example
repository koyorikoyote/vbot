# VBot Configuration
# Copy to .env and fill in values

# Server
SERVER_PORT=8090

# LLM (Ollama OpenAI-compatible)
VLLM_ENDPOINT=http://localhost:11434
VLLM_MODEL_NAME=llama3.1:8b
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30s

# Embeddings
EMBEDDING_ENDPOINT=http://localhost:11434
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIMENSION=768

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# TTS (Piper)
TTS_ENDPOINT=http://localhost:5000
TTS_TIMEOUT=15s
TTS_FORCE_SAPI=false

# STT (Whisper)
WHISPER_ENDPOINT=http://localhost:9000
WHISPER_MODEL=ggml-medium.bin
WHISPER_TIMEOUT=10m
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Ingestion
INGEST_CHUNK_DURATION_MIN=10
INGEST_OVERLAP_SEC=10
INGEST_WORKERS=2
INGEST_DEDUPE_THRESHOLD=0.90
INGEST_UPLOAD_DIR=data/uploads
INGEST_MAX_FILE_SIZE_MB=4096

# VBot
VBOT_PERSONALITY_FILE=data/personalities/immergold.yaml
VBOT_RAG_TOP_K=5
VBOT_RAG_SCORE_THRESHOLD=0.70
VBOT_CACHE_TTL=30m
VBOT_CACHE_SIMILARITY_THRESHOLD=0.92
VBOT_MEMORY_WINDOW_SIZE=12

# Logging
LOG_LEVEL=info
